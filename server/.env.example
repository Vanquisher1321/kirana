# ---------------------------------------------------------------------------
# Razorpay — TEST MODE ONLY. Never put a live key in this file.
# Dashboard -> toggle to "Test Mode" -> Settings -> API Keys -> Generate Test Key
# The key id must start with rzp_test_. The secret is shown exactly once.
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=

# Settings -> Webhooks -> Add New Webhook.
# URL:    <your zrok public url>/webhooks/razorpay
# Events: payment.captured, payment.failed, order.paid, payment_link.paid
# You choose this secret yourself when creating the webhook; paste the same value here.
RAZORPAY_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Access model.
#   demo   — nothing gated. The public sandbox, and local development.
#   locked — reading open; approving, connecting a shop, pausing and issuing a
#            key need KIRANA_CONSOLE_TOKEN.
# Leave blank and it picks itself: demo on plain localhost, locked as soon as
# PUBLIC_ORIGIN is set, so a console is never internet-facing and open by
# accident. Set demo explicitly if you tunnel your dev machine and don't want
# to keep pasting a token.
# ---------------------------------------------------------------------------
KIRANA_ACCESS=

# ---------------------------------------------------------------------------
# Console token. The console can approve spending, pause every agent and read
# the whole audit trail, so it is password-protected. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# If you leave this blank the server mints a NEW token on every restart and
# prints it in the startup log — fine for a quick test, irritating mid-demo.
# ---------------------------------------------------------------------------
KIRANA_CONSOLE_TOKEN=

# ---------------------------------------------------------------------------
# Quote signing. Generate once, keep it out of git:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset, the server generates an ephemeral secret at boot and warns — fine
# for local dev, but quotes will not survive a restart.
# ---------------------------------------------------------------------------
KIRANA_SIGNING_SECRET=

# ---------------------------------------------------------------------------
# OPTIONAL. Only used by the bottom rung of the ingestion ladder (raw HTML
# stores). Shopify and WooCommerce ingestion never calls a model, so the demo
# path costs nothing. Pick at most one.
# ---------------------------------------------------------------------------
# LLM_PROVIDER=ollama|groq|gemini|none
LLM_PROVIDER=none
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
GROQ_API_KEY=
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=3000
KIRANA_DB=data/kirana.db
# Your zrok/ngrok public origin, e.g. https://abc123.share.zrok.io
# Used to build the MCP endpoint URL handed to buyer agents.
PUBLIC_ORIGIN=
