{
  "name": "kirana-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --experimental-sqlite --experimental-strip-types --watch src/index.ts",
    "start": "node --env-file-if-exists=.env --experimental-sqlite --experimental-strip-types src/index.ts",
    "ingest": "node --env-file-if-exists=.env --experimental-sqlite --experimental-strip-types src/cli/ingest.ts",
    "test": "node --experimental-sqlite --experimental-strip-types --test",
    "typecheck": "tsc -p tsconfig.json",
    "seed": "node --env-file-if-exists=.env --experimental-sqlite --experimental-strip-types src/cli/seed.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "fastify": "^5.2.0",
    "pino-pretty": "^13.1.3",
    "zod": "^3.24.1",
    "@fastify/static": "^8.0.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3"
  }
}