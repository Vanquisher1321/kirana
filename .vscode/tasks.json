{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "zrok: share public 3000",
      "type": "shell",
      "command": "zrok share public 3000",
      "isBackground": true,
      "presentation": {
        "panel": "dedicated",
        "group": "nexus",
        "reveal": "always"
      },
      "problemMatcher": {
        "pattern": [
          {
            "regexp": ".",
            "file": 1,
            "location": 2,
            "message": 3
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": ".*(share.zrok.io|https://).*"
        }
      }
    },
    {
      "label": "nexus: test",
      "type": "shell",
      "command": "npm test",
      "options": {
        "cwd": "${workspaceFolder}/server"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "panel": "dedicated",
        "group": "nexus"
      },
      "problemMatcher": []
    },
    {
      "label": "nexus: typecheck",
      "type": "shell",
      "command": "npx tsc -p tsconfig.json",
      "options": {
        "cwd": "${workspaceFolder}/server"
      },
      "group": "build",
      "problemMatcher": [
        "$tsc"
      ]
    },
    {
      "label": "nexus: seed demo store",
      "type": "shell",
      "command": "npm run seed",
      "options": {
        "cwd": "${workspaceFolder}/server"
      },
      "presentation": {
        "panel": "dedicated",
        "group": "nexus"
      },
      "problemMatcher": []
    },
    {
      "label": "nexus: reset database",
      "type": "shell",
      "command": "Remove-Item -Force -ErrorAction SilentlyContinue data/nexus.db*; npm run seed",
      "options": {
        "cwd": "${workspaceFolder}/server",
        "shell": {
          "executable": "powershell.exe",
          "args": [
            "-NoProfile",
            "-Command"
          ]
        }
      },
      "presentation": {
        "panel": "dedicated",
        "group": "nexus"
      },
      "problemMatcher": []
    },
    {
      "label": "nexus: verify audit chain",
      "type": "shell",
      "command": "curl -s http://localhost:3000/api/audit/verify",
      "presentation": {
        "panel": "dedicated",
        "group": "nexus"
      },
      "problemMatcher": []
    },
    {
      "label": "web: dev server (live reload)",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/web"
      },
      "isBackground": true,
      "presentation": {
        "panel": "dedicated",
        "group": "nexus"
      },
      "problemMatcher": []
    },
    {
      "label": "web: build for demo",
      "type": "shell",
      "command": "npm run build",
      "options": {
        "cwd": "${workspaceFolder}/web"
      },
      "presentation": {
        "panel": "dedicated",
        "group": "nexus"
      },
      "problemMatcher": []
    }
  ]
}