node_modules/
dist/

# Every .env variant, including backups and copies. A narrow `.env` rule let a
# `.env.backup-before-rename` into a commit once; this is the fix.
.env*
!.env.example
*.log
# Databases and test artefacts never belong in the tree.
server/data/
web/dist/
artifacts/*
!artifacts/.gitkeep
.DS_Store
